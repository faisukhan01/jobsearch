APP_NAME=JobPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

LOG_CHANNEL=stack

# Shared secret — must match the Next.js BFF's JOBPILOT_WEBHOOK_SECRET
JOBPILOT_WEBHOOK_SECRET=change-me

MAIL_MAILER=log
MAIL_FROM_ADDRESS=autopilot@jobpilot.local
MAIL_FROM_NAME="${APP_NAME}"
