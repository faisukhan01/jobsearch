{
    "name": "jobsearch/notification-service",
    "type": "project",
    "description": "JobPilot notification & webhook microservice — Laravel 11. Handles application-status webhooks, email digests and outbound integrations for the JobPilot autopilot platform.",
    "keywords": ["laravel", "job-search", "webhooks", "notifications", "microservice"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.9",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php artisan serve --host=0.0.0.0 --port=8080",
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
