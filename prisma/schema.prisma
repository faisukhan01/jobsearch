generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Job Seeker Profile ────────────────────────────────────────────────
model Profile {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  phone          String?
  location       String   @default("Remote")
  headline       String?
  summary        String?
  skills         String   @default("[]") // JSON string[]
  experienceYears Int     @default(0)
  desiredSalary  Int?
  currency       String   @default("USD")
  resumeFileName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Connected Job Portals ─────────────────────────────────────────────
model Connector {
  id           String    @id @default(cuid())
  platform     String    @unique // indeed | linkedin | glassdoor | ziprecruiter | greenhouse | lever
  status       String    @default("disconnected") // connected | disconnected | error
  accountEmail String?
  apiKey       String? // stored credential / session token
  autoApply    Boolean   @default(false)
  lastSyncAt   DateTime?
  syncedJobs   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── Discovered Jobs ───────────────────────────────────────────────────
model Job {
  id             String   @id @default(cuid())
  externalId     String?  @unique
  platform       String
  title          String
  company        String
  companyLogo    String? // emoji or initials based avatar seed
  location       String
  remote         Boolean  @default(false)
  employmentType String   @default("FULL_TIME")
  salaryMin      Int?
  salaryMax      Int?
  currency       String   @default("USD")
  description    String?
  tags           String   @default("[]") // JSON string[]
  easyApply      Boolean  @default(false)
  matchScore     Int      @default(0)
  status         String   @default("discovered") // discovered | saved | dismissed
  postedAt       DateTime?
  createdAt      DateTime @default(now())
  applications   Application[]
  docs           TailoredDoc[]

  @@index([platform])
  @@index([matchScore])
}

// ─── Applications (the autopilot output) ───────────────────────────────
model Application {
  id             String    @id @default(cuid())
  jobId          String
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status         String    @default("queued") // queued | applied | screening | interview | offer | rejected | withdrawn
  method         String    @default("autopilot") // autopilot | manual
  matchScore     Int       @default(0)
  coverLetter    String?
  tailoredResume String?
  appliedAt      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

// ─── Autopilot Configuration ───────────────────────────────────────────
model AutomationConfig {
  id              String    @id @default(cuid())
  enabled         Boolean   @default(false)
  keywords        String    @default("Software Engineer, Full Stack, Backend")
  locations       String    @default("Remote, United States")
  remoteOnly      Boolean   @default(true)
  minSalary       Int       @default(80000)
  employmentTypes String    @default("[\"FULL_TIME\",\"CONTRACT\"]")
  dailyLimit      Int       @default(15)
  minMatchScore   Int       @default(70)
  autoTailor      Boolean   @default(true)
  autoCoverLetter Boolean   @default(true)
  appliedToday    Int       @default(0)
  totalApplied    Int       @default(0)
  lastRunAt       DateTime?
  updatedAt       DateTime  @updatedAt
}

// ─── Activity / Event Log ──────────────────────────────────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  type      String   // info | success | warning | error | apply | sync | ai
  platform  String?
  message   String
  meta      String? // JSON
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── AI Generated Documents ────────────────────────────────────────────
model TailoredDoc {
  id        String   @id @default(cuid())
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  kind      String // cover_letter | resume_bullets | outreach_message
  content   String
  model     String?
  createdAt DateTime @default(now())
}
